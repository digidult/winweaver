{
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "vercel": true
    }
  },
  "headers": [
    {
      "source": "/(.*).wasm",
      "headers": [{ "key": "Content-Type", "value": "application/wasm" }]
    },
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
