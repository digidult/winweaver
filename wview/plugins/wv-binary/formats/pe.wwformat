{
  "format": "wwformat",
  "version": 1,
  "name": "Portable Executable",
  "extensions": ["exe", "dll", "sys", "ocx", "cpl", "efi", "mui", "scr", "drv"],
  "mimes": ["application/vnd.microsoft.portable-executable"],
  "endian": "little",
  "magic": [{ "at": 0, "bytes": "4D5A" }],
  "root": "file",
  "spaces": {
    "rva": {
      "table": "sections",
      "virtual": "virtual_address",
      "size": "virtual_size",
      "file": "pointer_to_raw_data",
      "file_size": "size_of_raw_data"
    }
  },
  "types": {
    "file": { "fields": [
      { "name": "dos_header", "type": "IMAGE_DOS_HEADER" },
      { "name": "nt_headers", "type": "IMAGE_NT_HEADERS", "at": "dos_header.e_lfanew",
        "when": "u32(dos_header.e_lfanew) == 0x4550" },
      { "name": "sections", "type": "IMAGE_SECTION_HEADER", "key": "name",
        "count": "nt_headers.file_header.number_of_sections",
        "at": "nt_headers.optional_header.@offset + nt_headers.file_header.size_of_optional_header" },
      { "name": "exports", "type": "IMAGE_EXPORT_DIRECTORY",
        "rva": "nt_headers.optional_header.data_directories.export_table.virtual_address",
        "when": "nt_headers.optional_header.data_directories.export_table.size != 0" },
      { "name": "imports", "type": "IMAGE_IMPORT_DESCRIPTOR", "key": "dll", "terminated": true,
        "rva": "nt_headers.optional_header.data_directories.import_table.virtual_address",
        "when": "nt_headers.optional_header.data_directories.import_table.size != 0" },
      { "name": "resources", "type": "RESOURCE_TYPES", "rva": "nt_headers.optional_header.data_directories.resource_table.virtual_address",
        "when": "nt_headers.optional_header.data_directories.resource_table.size != 0" },
      { "name": "exceptions", "type": "RUNTIME_FUNCTION", "count": "nt_headers.optional_header.data_directories.exception_table.size / 12",
        "rva": "nt_headers.optional_header.data_directories.exception_table.virtual_address",
        "when": "nt_headers.optional_header.data_directories.exception_table.size != 0 && nt_headers.file_header.machine == 0x8664" },
      { "name": "certificates", "type": "WIN_CERTIFICATE", "align": 8, "length": "nt_headers.optional_header.data_directories.certificate_table.size",
        "at": "nt_headers.optional_header.data_directories.certificate_table.virtual_address",
        "when": "nt_headers.optional_header.data_directories.certificate_table.size != 0" },
      { "name": "relocations", "type": "IMAGE_BASE_RELOCATION", "key": "virtual_address", "length": "nt_headers.optional_header.data_directories.base_relocation_table.size",
        "rva": "nt_headers.optional_header.data_directories.base_relocation_table.virtual_address",
        "when": "nt_headers.optional_header.data_directories.base_relocation_table.size != 0" },
      { "name": "debug", "type": "IMAGE_DEBUG_DIRECTORY", "key": "type", "count": "nt_headers.optional_header.data_directories.debug.size / 28",
        "rva": "nt_headers.optional_header.data_directories.debug.virtual_address",
        "when": "nt_headers.optional_header.data_directories.debug.size != 0" },
      { "name": "tls", "switch": "nt_headers.optional_header.magic",
        "cases": { "0x10b": "IMAGE_TLS_DIRECTORY32", "0x20b": "IMAGE_TLS_DIRECTORY64" }, "rva": "nt_headers.optional_header.data_directories.tls_table.virtual_address",
        "when": "nt_headers.optional_header.data_directories.tls_table.size != 0" },
      { "name": "load_config", "switch": "nt_headers.optional_header.magic",
        "cases": { "0x10b": "IMAGE_LOAD_CONFIG_DIRECTORY32", "0x20b": "IMAGE_LOAD_CONFIG_DIRECTORY64" }, "rva": "nt_headers.optional_header.data_directories.load_config_table.virtual_address",
        "when": "nt_headers.optional_header.data_directories.load_config_table.size != 0" },
      { "name": "delay_imports", "type": "IMAGE_DELAYLOAD_DESCRIPTOR", "key": "dll", "terminated": true, "rva": "nt_headers.optional_header.data_directories.delay_import_descriptor.virtual_address",
        "when": "nt_headers.optional_header.data_directories.delay_import_descriptor.size != 0" },
      { "name": "clr", "type": "IMAGE_COR20_HEADER", "rva": "nt_headers.optional_header.data_directories.clr_runtime_header.virtual_address",
        "when": "nt_headers.optional_header.data_directories.clr_runtime_header.size != 0" }
    ] },
    "IMAGE_DOS_HEADER": { "fields": [
      { "name": "e_magic", "type": "u16", "show": "hex" },
      { "name": "e_cblp", "type": "u16" },
      { "name": "e_cp", "type": "u16" },
      { "name": "e_crlc", "type": "u16" },
      { "name": "e_cparhdr", "type": "u16" },
      { "name": "e_minalloc", "type": "u16" },
      { "name": "e_maxalloc", "type": "u16" },
      { "name": "e_ss", "type": "u16", "show": "hex" },
      { "name": "e_sp", "type": "u16", "show": "hex" },
      { "name": "e_csum", "type": "u16", "show": "hex" },
      { "name": "e_ip", "type": "u16", "show": "hex" },
      { "name": "e_cs", "type": "u16", "show": "hex" },
      { "name": "e_lfarlc", "type": "u16", "show": "hex" },
      { "name": "e_ovno", "type": "u16" },
      { "name": "e_res", "type": "raw", "size": "8" },
      { "name": "e_oemid", "type": "u16" },
      { "name": "e_oeminfo", "type": "u16" },
      { "name": "e_res2", "type": "raw", "size": "20" },
      { "name": "e_lfanew", "type": "u32", "show": "hex" },
      { "name": "dos_stub", "type": "raw", "at": "64", "size": "e_lfanew - 64",
        "when": "e_lfanew > 64" }
    ] },
    "IMAGE_NT_HEADERS": { "fields": [
      { "name": "signature", "type": "u32", "show": "hex" },
      { "name": "file_header", "type": "IMAGE_FILE_HEADER" },
      { "name": "optional_header", "switch": "u16(@here)",
        "cases": { "0x10b": "IMAGE_OPTIONAL_HEADER32", "0x20b": "IMAGE_OPTIONAL_HEADER64" },
        "when": "file_header.size_of_optional_header != 0" }
    ] },
    "IMAGE_FILE_HEADER": { "fields": [
      { "name": "machine", "type": "u16", "show": "hex", "enum": "machine" },
      { "name": "number_of_sections", "type": "u16" },
      { "name": "time_date_stamp", "type": "u32", "show": "time" },
      { "name": "pointer_to_symbol_table", "type": "u32", "show": "hex" },
      { "name": "number_of_symbols", "type": "u32" },
      { "name": "size_of_optional_header", "type": "u16", "show": "hex" },
      { "name": "characteristics", "type": "u16", "show": "hex", "flags": "file_characteristics" }
    ] },
    "IMAGE_OPTIONAL_HEADER32": { "fields": [
      { "name": "magic", "type": "u16", "show": "hex", "enum": "optional_magic" },
      { "name": "major_linker_version", "type": "u8" },
      { "name": "minor_linker_version", "type": "u8" },
      { "name": "size_of_code", "type": "u32", "show": "hex" },
      { "name": "size_of_initialized_data", "type": "u32", "show": "hex" },
      { "name": "size_of_uninitialized_data", "type": "u32", "show": "hex" },
      { "name": "address_of_entry_point", "type": "u32", "show": "hex" },
      { "name": "base_of_code", "type": "u32", "show": "hex" },
      { "name": "base_of_data", "type": "u32", "show": "hex" },
      { "name": "image_base", "type": "u32", "show": "hex" },
      { "name": "section_alignment", "type": "u32", "show": "hex" },
      { "name": "file_alignment", "type": "u32", "show": "hex" },
      { "name": "major_operating_system_version", "type": "u16" },
      { "name": "minor_operating_system_version", "type": "u16" },
      { "name": "major_image_version", "type": "u16" },
      { "name": "minor_image_version", "type": "u16" },
      { "name": "major_subsystem_version", "type": "u16" },
      { "name": "minor_subsystem_version", "type": "u16" },
      { "name": "win32_version_value", "type": "u32" },
      { "name": "size_of_image", "type": "u32", "show": "hex" },
      { "name": "size_of_headers", "type": "u32", "show": "hex" },
      { "name": "checksum", "type": "u32", "show": "hex" },
      { "name": "subsystem", "type": "u16", "enum": "subsystem" },
      { "name": "dll_characteristics", "type": "u16", "show": "hex", "flags": "dll_characteristics" },
      { "name": "size_of_stack_reserve", "type": "u32", "show": "hex" },
      { "name": "size_of_stack_commit", "type": "u32", "show": "hex" },
      { "name": "size_of_heap_reserve", "type": "u32", "show": "hex" },
      { "name": "size_of_heap_commit", "type": "u32", "show": "hex" },
      { "name": "loader_flags", "type": "u32", "show": "hex" },
      { "name": "number_of_rva_and_sizes", "type": "u32" },
      { "name": "data_directories", "type": "IMAGE_DATA_DIRECTORIES" }
    ] },
    "IMAGE_OPTIONAL_HEADER64": { "fields": [
      { "name": "magic", "type": "u16", "show": "hex", "enum": "optional_magic" },
      { "name": "major_linker_version", "type": "u8" },
      { "name": "minor_linker_version", "type": "u8" },
      { "name": "size_of_code", "type": "u32", "show": "hex" },
      { "name": "size_of_initialized_data", "type": "u32", "show": "hex" },
      { "name": "size_of_uninitialized_data", "type": "u32", "show": "hex" },
      { "name": "address_of_entry_point", "type": "u32", "show": "hex" },
      { "name": "base_of_code", "type": "u32", "show": "hex" },
      { "name": "image_base", "type": "u64", "show": "hex" },
      { "name": "section_alignment", "type": "u32", "show": "hex" },
      { "name": "file_alignment", "type": "u32", "show": "hex" },
      { "name": "major_operating_system_version", "type": "u16" },
      { "name": "minor_operating_system_version", "type": "u16" },
      { "name": "major_image_version", "type": "u16" },
      { "name": "minor_image_version", "type": "u16" },
      { "name": "major_subsystem_version", "type": "u16" },
      { "name": "minor_subsystem_version", "type": "u16" },
      { "name": "win32_version_value", "type": "u32" },
      { "name": "size_of_image", "type": "u32", "show": "hex" },
      { "name": "size_of_headers", "type": "u32", "show": "hex" },
      { "name": "checksum", "type": "u32", "show": "hex" },
      { "name": "subsystem", "type": "u16", "enum": "subsystem" },
      { "name": "dll_characteristics", "type": "u16", "show": "hex", "flags": "dll_characteristics" },
      { "name": "size_of_stack_reserve", "type": "u64", "show": "hex" },
      { "name": "size_of_stack_commit", "type": "u64", "show": "hex" },
      { "name": "size_of_heap_reserve", "type": "u64", "show": "hex" },
      { "name": "size_of_heap_commit", "type": "u64", "show": "hex" },
      { "name": "loader_flags", "type": "u32", "show": "hex" },
      { "name": "number_of_rva_and_sizes", "type": "u32" },
      { "name": "data_directories", "type": "IMAGE_DATA_DIRECTORIES" }
    ] },
    "IMAGE_DATA_DIRECTORIES": { "fields": [
      { "name": "export_table", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 0" },
      { "name": "import_table", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 1" },
      { "name": "resource_table", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 2" },
      { "name": "exception_table", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 3" },
      { "name": "certificate_table", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 4" },
      { "name": "base_relocation_table", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 5" },
      { "name": "debug", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 6" },
      { "name": "architecture", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 7" },
      { "name": "global_ptr", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 8" },
      { "name": "tls_table", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 9" },
      { "name": "load_config_table", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 10" },
      { "name": "bound_import", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 11" },
      { "name": "iat", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 12" },
      { "name": "delay_import_descriptor", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 13" },
      { "name": "clr_runtime_header", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 14" },
      { "name": "reserved", "type": "IMAGE_DATA_DIRECTORY", "when": "number_of_rva_and_sizes > 15" }
    ] },
    "IMAGE_DATA_DIRECTORY": { "fields": [
      { "name": "virtual_address", "type": "u32", "show": "hex" },
      { "name": "size", "type": "u32", "show": "hex" }
    ] },
    "IMAGE_SECTION_HEADER": { "fields": [
      { "name": "name", "type": "text", "size": "8" },
      { "name": "virtual_size", "type": "u32", "show": "hex" },
      { "name": "virtual_address", "type": "u32", "show": "hex" },
      { "name": "size_of_raw_data", "type": "u32", "show": "hex" },
      { "name": "pointer_to_raw_data", "type": "u32", "show": "hex" },
      { "name": "pointer_to_relocations", "type": "u32", "show": "hex" },
      { "name": "pointer_to_linenumbers", "type": "u32", "show": "hex" },
      { "name": "number_of_relocations", "type": "u16" },
      { "name": "number_of_linenumbers", "type": "u16" },
      { "name": "characteristics", "type": "u32", "show": "hex", "flags": "section_characteristics" },
      { "name": "data", "type": "raw", "at": "pointer_to_raw_data", "size": "size_of_raw_data",
        "when": "size_of_raw_data != 0 && pointer_to_raw_data != 0" }
    ] },
    "IMAGE_EXPORT_DIRECTORY": { "fields": [
      { "name": "characteristics", "type": "u32", "show": "hex" },
      { "name": "time_date_stamp", "type": "u32", "show": "time" },
      { "name": "major_version", "type": "u16" },
      { "name": "minor_version", "type": "u16" },
      { "name": "name", "type": "u32", "show": "hex" },
      { "name": "base", "type": "u32" },
      { "name": "number_of_functions", "type": "u32" },
      { "name": "number_of_names", "type": "u32" },
      { "name": "address_of_functions", "type": "u32", "show": "hex" },
      { "name": "address_of_names", "type": "u32", "show": "hex" },
      { "name": "address_of_name_ordinals", "type": "u32", "show": "hex" },
      { "name": "dll", "type": "text", "rva": "name", "when": "name != 0" },
      { "name": "names", "type": "EXPORT_NAME", "key": "name", "count": "number_of_names",
        "rva": "address_of_names", "when": "number_of_names != 0" },
      { "name": "name_ordinals", "type": "u16", "count": "number_of_names",
        "rva": "address_of_name_ordinals", "when": "number_of_names != 0" },
      { "name": "functions", "type": "u32", "show": "hex", "count": "number_of_functions",
        "rva": "address_of_functions", "when": "number_of_functions != 0" }
    ] },
    "EXPORT_NAME": { "fields": [
      { "name": "name_rva", "type": "u32", "show": "hex" },
      { "name": "name", "type": "text", "rva": "name_rva" }
    ] },
    "IMAGE_IMPORT_DESCRIPTOR": { "fields": [
      { "name": "original_first_thunk", "type": "u32", "show": "hex" },
      { "name": "time_date_stamp", "type": "u32", "show": "hex" },
      { "name": "forwarder_chain", "type": "u32", "show": "hex" },
      { "name": "name", "type": "u32", "show": "hex" },
      { "name": "first_thunk", "type": "u32", "show": "hex" },
      { "name": "dll", "type": "text", "rva": "name", "when": "name != 0" },
      { "name": "functions", "switch": "nt_headers.optional_header.magic",
        "cases": { "0x10b": "IMAGE_THUNK_DATA32", "0x20b": "IMAGE_THUNK_DATA64" },
        "terminated": true, "key": ["function.name", "ordinal"],
        "rva": "original_first_thunk", "when": "original_first_thunk != 0" },
      { "name": "functions", "switch": "nt_headers.optional_header.magic",
        "cases": { "0x10b": "IMAGE_THUNK_DATA32", "0x20b": "IMAGE_THUNK_DATA64" },
        "terminated": true, "key": ["function.name", "ordinal"],
        "rva": "first_thunk", "when": "original_first_thunk == 0 && first_thunk != 0" }
    ] },
    "IMAGE_THUNK_DATA32": { "fields": [
      { "name": "value", "type": "u32", "show": "hex" },
      { "name": "function", "type": "IMAGE_IMPORT_BY_NAME", "rva": "value & 0x7FFFFFFF",
        "when": "value != 0 && (value >> 31) == 0" },
      { "name": "ordinal", "value": "value & 0xFFFF", "when": "(value >> 31) != 0" }
    ] },
    "IMAGE_THUNK_DATA64": { "fields": [
      { "name": "value", "type": "u64", "show": "hex" },
      { "name": "function", "type": "IMAGE_IMPORT_BY_NAME", "rva": "value & 0x7FFFFFFF",
        "when": "value != 0 && (value >> 63) == 0" },
      { "name": "ordinal", "value": "value & 0xFFFF", "when": "(value >> 63) != 0" }
    ] },
    "RESOURCE_TYPES": { "fields": [
      { "name": "characteristics", "type": "u32", "show": "hex" },
      { "name": "time_date_stamp", "type": "u32", "show": "time" },
      { "name": "major_version", "type": "u16" },
      { "name": "minor_version", "type": "u16" },
      { "name": "number_of_named_entries", "type": "u16" },
      { "name": "number_of_id_entries", "type": "u16" },
      { "name": "entries", "type": "RESOURCE_TYPE_ENTRY", "key": ["name_string.text", "id"],
        "count": "number_of_named_entries + number_of_id_entries" }
    ] },
    "RESOURCE_NAMES": { "fields": [
      { "name": "characteristics", "type": "u32", "show": "hex" },
      { "name": "time_date_stamp", "type": "u32", "show": "time" },
      { "name": "major_version", "type": "u16" },
      { "name": "minor_version", "type": "u16" },
      { "name": "number_of_named_entries", "type": "u16" },
      { "name": "number_of_id_entries", "type": "u16" },
      { "name": "entries", "type": "RESOURCE_NAME_ENTRY", "key": ["name_string.text", "id"],
        "count": "number_of_named_entries + number_of_id_entries" }
    ] },
    "RESOURCE_LANGUAGES": { "fields": [
      { "name": "characteristics", "type": "u32", "show": "hex" },
      { "name": "time_date_stamp", "type": "u32", "show": "time" },
      { "name": "major_version", "type": "u16" },
      { "name": "minor_version", "type": "u16" },
      { "name": "number_of_named_entries", "type": "u16" },
      { "name": "number_of_id_entries", "type": "u16" },
      { "name": "entries", "type": "RESOURCE_LANGUAGE_ENTRY", "key": ["name_string.text", "language"],
        "count": "number_of_named_entries + number_of_id_entries" }
    ] },
    "RESOURCE_TYPE_ENTRY": { "fields": [
      { "name": "name", "type": "u32", "show": "hex" },
      { "name": "offset_to_data", "type": "u32", "show": "hex" },
      { "name": "id", "value": "name & 0xFFFF", "enum": "resource_type", "when": "(name >> 31) == 0" },
      { "name": "name_string", "type": "RESOURCE_STRING", "at": "resources.@offset + (name & 0x7FFFFFFF)",
        "when": "(name >> 31) != 0" },
      { "name": "names", "type": "RESOURCE_NAMES", "lazy": true,
        "at": "resources.@offset + (offset_to_data & 0x7FFFFFFF)", "when": "(offset_to_data >> 31) != 0",
        "content": { "switch": "id", "cases": { "1": "image/x-dib-cursor", "2": "image/x-dib",
          "3": "image/x-dib-icon", "12": "application/octet-stream",
          "14": "image/x-group-icon; members=ICON",
          "23": "text/html", "24": "application/xml" } } }
    ] },
    "RESOURCE_NAME_ENTRY": { "fields": [
      { "name": "name", "type": "u32", "show": "hex" },
      { "name": "offset_to_data", "type": "u32", "show": "hex" },
      { "name": "id", "value": "name & 0xFFFF", "when": "(name >> 31) == 0" },
      { "name": "name_string", "type": "RESOURCE_STRING", "at": "resources.@offset + (name & 0x7FFFFFFF)",
        "when": "(name >> 31) != 0" },
      { "name": "languages", "type": "RESOURCE_LANGUAGES", "lazy": true,
        "at": "resources.@offset + (offset_to_data & 0x7FFFFFFF)", "when": "(offset_to_data >> 31) != 0" }
    ] },
    "RESOURCE_LANGUAGE_ENTRY": { "fields": [
      { "name": "name", "type": "u32", "show": "hex" },
      { "name": "offset_to_data", "type": "u32", "show": "hex" },
      { "name": "language", "value": "name & 0xFFFF", "show": "hex", "when": "(name >> 31) == 0" },
      { "name": "name_string", "type": "RESOURCE_STRING", "at": "resources.@offset + (name & 0x7FFFFFFF)",
        "when": "(name >> 31) != 0" },
      { "name": "data", "type": "IMAGE_RESOURCE_DATA_ENTRY", "at": "resources.@offset + offset_to_data",
        "when": "(offset_to_data >> 31) == 0" }
    ] },
    "RESOURCE_STRING": { "fields": [
      { "name": "length", "type": "u16" },
      { "name": "text", "type": "utf16", "size": "length * 2" }
    ] },
    "IMAGE_RESOURCE_DATA_ENTRY": { "fields": [
      { "name": "offset_to_data", "type": "u32", "show": "hex" },
      { "name": "size", "type": "u32", "show": "hex" },
      { "name": "code_page", "type": "u32" },
      { "name": "reserved", "type": "u32" },
      { "name": "bytes", "type": "raw", "rva": "offset_to_data", "size": "size", "when": "size != 0" }
    ] },
    "RUNTIME_FUNCTION": { "fields": [
      { "name": "begin_address", "type": "u32", "show": "hex" },
      { "name": "end_address", "type": "u32", "show": "hex" },
      { "name": "unwind_info_address", "type": "u32", "show": "hex" }
    ] },
    "WIN_CERTIFICATE": { "fields": [
      { "name": "length", "type": "u32", "show": "hex" },
      { "name": "revision", "type": "u16", "show": "hex", "enum": "certificate_revision" },
      { "name": "certificate_type", "type": "u16", "show": "hex", "enum": "certificate_type" },
      { "name": "certificate", "type": "raw", "size": "length - 8", "when": "length > 8" }
    ] },
    "IMAGE_BASE_RELOCATION": { "fields": [
      { "name": "virtual_address", "type": "u32", "show": "hex" },
      { "name": "size_of_block", "type": "u32", "show": "hex" },
      { "name": "entries", "type": "u16", "show": "hex", "count": "(size_of_block - 8) / 2",
        "when": "size_of_block > 8" }
    ] },
    "IMAGE_DEBUG_DIRECTORY": { "fields": [
      { "name": "characteristics", "type": "u32", "show": "hex" },
      { "name": "time_date_stamp", "type": "u32", "show": "time" },
      { "name": "major_version", "type": "u16" },
      { "name": "minor_version", "type": "u16" },
      { "name": "type", "type": "u32", "enum": "debug_type" },
      { "name": "size_of_data", "type": "u32", "show": "hex" },
      { "name": "address_of_raw_data", "type": "u32", "show": "hex" },
      { "name": "pointer_to_raw_data", "type": "u32", "show": "hex" },
      { "name": "codeview", "type": "CODEVIEW_PDB70", "at": "pointer_to_raw_data",
        "when": "type == 2 && size_of_data >= 24 && u32(pointer_to_raw_data) == 0x53445352" },
      { "name": "data", "type": "raw", "at": "pointer_to_raw_data", "size": "size_of_data",
        "when": "pointer_to_raw_data != 0 && size_of_data != 0" }
    ] },
    "CODEVIEW_PDB70": { "fields": [
      { "name": "signature", "type": "u32", "show": "hex" },
      { "name": "guid", "type": "raw", "size": "16" },
      { "name": "age", "type": "u32" },
      { "name": "pdb", "type": "text" }
    ] },
    "IMAGE_TLS_DIRECTORY32": { "fields": [
      { "name": "start_address_of_raw_data", "type": "u32", "show": "hex" },
      { "name": "end_address_of_raw_data", "type": "u32", "show": "hex" },
      { "name": "address_of_index", "type": "u32", "show": "hex" },
      { "name": "address_of_callbacks", "type": "u32", "show": "hex" },
      { "name": "size_of_zero_fill", "type": "u32", "show": "hex" },
      { "name": "characteristics", "type": "u32", "show": "hex" },
      { "name": "callbacks", "type": "u32", "show": "hex", "terminated": true,
        "rva": "address_of_callbacks - nt_headers.optional_header.image_base",
        "when": "address_of_callbacks > nt_headers.optional_header.image_base" }
    ] },
    "IMAGE_TLS_DIRECTORY64": { "fields": [
      { "name": "start_address_of_raw_data", "type": "u64", "show": "hex" },
      { "name": "end_address_of_raw_data", "type": "u64", "show": "hex" },
      { "name": "address_of_index", "type": "u64", "show": "hex" },
      { "name": "address_of_callbacks", "type": "u64", "show": "hex" },
      { "name": "size_of_zero_fill", "type": "u32", "show": "hex" },
      { "name": "characteristics", "type": "u32", "show": "hex" },
      { "name": "callbacks", "type": "u64", "show": "hex", "terminated": true,
        "rva": "address_of_callbacks - nt_headers.optional_header.image_base",
        "when": "address_of_callbacks > nt_headers.optional_header.image_base" }
    ] },
    "IMAGE_LOAD_CONFIG_DIRECTORY32": { "fields": [
      { "name": "size", "type": "u32" },
      { "name": "time_date_stamp", "type": "u32", "show": "time", "when": "size >= 8" },
      { "name": "major_version", "type": "u16", "when": "size >= 10" },
      { "name": "minor_version", "type": "u16", "when": "size >= 12" },
      { "name": "global_flags_clear", "type": "u32", "show": "hex", "when": "size >= 16" },
      { "name": "global_flags_set", "type": "u32", "show": "hex", "when": "size >= 20" },
      { "name": "critical_section_default_timeout", "type": "u32", "when": "size >= 24" },
      { "name": "decommit_free_block_threshold", "type": "u32", "show": "hex", "when": "size >= 28" },
      { "name": "decommit_total_free_threshold", "type": "u32", "show": "hex", "when": "size >= 32" },
      { "name": "lock_prefix_table", "type": "u32", "show": "hex", "when": "size >= 36" },
      { "name": "maximum_allocation_size", "type": "u32", "show": "hex", "when": "size >= 40" },
      { "name": "virtual_memory_threshold", "type": "u32", "show": "hex", "when": "size >= 44" },
      { "name": "process_heap_flags", "type": "u32", "show": "hex", "when": "size >= 48" },
      { "name": "process_affinity_mask", "type": "u32", "show": "hex", "when": "size >= 52" },
      { "name": "csd_version", "type": "u16", "when": "size >= 54" },
      { "name": "dependent_load_flags", "type": "u16", "show": "hex", "when": "size >= 56" },
      { "name": "edit_list", "type": "u32", "show": "hex", "when": "size >= 60" },
      { "name": "security_cookie", "type": "u32", "show": "hex", "when": "size >= 64" },
      { "name": "se_handler_table", "type": "u32", "show": "hex", "when": "size >= 68" },
      { "name": "se_handler_count", "type": "u32", "when": "size >= 72" },
      { "name": "guard_cf_check_function_pointer", "type": "u32", "show": "hex", "when": "size >= 76" },
      { "name": "guard_cf_dispatch_function_pointer", "type": "u32", "show": "hex", "when": "size >= 80" },
      { "name": "guard_cf_function_table", "type": "u32", "show": "hex", "when": "size >= 84" },
      { "name": "guard_cf_function_count", "type": "u32", "when": "size >= 88" },
      { "name": "guard_flags", "type": "u32", "show": "hex", "flags": "guard_flags", "when": "size >= 92" },
      { "name": "code_integrity", "type": "raw", "size": "12", "when": "size >= 104" },
      { "name": "guard_address_taken_iat_entry_table", "type": "u32", "show": "hex", "when": "size >= 108" },
      { "name": "guard_address_taken_iat_entry_count", "type": "u32", "when": "size >= 112" },
      { "name": "guard_long_jump_target_table", "type": "u32", "show": "hex", "when": "size >= 116" },
      { "name": "guard_long_jump_target_count", "type": "u32", "when": "size >= 120" },
      { "name": "dynamic_value_reloc_table", "type": "u32", "show": "hex", "when": "size >= 124" },
      { "name": "chpe_metadata_pointer", "type": "u32", "show": "hex", "when": "size >= 128" }
    ] },
    "IMAGE_LOAD_CONFIG_DIRECTORY64": { "fields": [
      { "name": "size", "type": "u32" },
      { "name": "time_date_stamp", "type": "u32", "show": "time", "when": "size >= 8" },
      { "name": "major_version", "type": "u16", "when": "size >= 10" },
      { "name": "minor_version", "type": "u16", "when": "size >= 12" },
      { "name": "global_flags_clear", "type": "u32", "show": "hex", "when": "size >= 16" },
      { "name": "global_flags_set", "type": "u32", "show": "hex", "when": "size >= 20" },
      { "name": "critical_section_default_timeout", "type": "u32", "when": "size >= 24" },
      { "name": "decommit_free_block_threshold", "type": "u64", "show": "hex", "when": "size >= 32" },
      { "name": "decommit_total_free_threshold", "type": "u64", "show": "hex", "when": "size >= 40" },
      { "name": "lock_prefix_table", "type": "u64", "show": "hex", "when": "size >= 48" },
      { "name": "maximum_allocation_size", "type": "u64", "show": "hex", "when": "size >= 56" },
      { "name": "virtual_memory_threshold", "type": "u64", "show": "hex", "when": "size >= 64" },
      { "name": "process_affinity_mask", "type": "u64", "show": "hex", "when": "size >= 72" },
      { "name": "process_heap_flags", "type": "u32", "show": "hex", "when": "size >= 76" },
      { "name": "csd_version", "type": "u16", "when": "size >= 78" },
      { "name": "dependent_load_flags", "type": "u16", "show": "hex", "when": "size >= 80" },
      { "name": "edit_list", "type": "u64", "show": "hex", "when": "size >= 88" },
      { "name": "security_cookie", "type": "u64", "show": "hex", "when": "size >= 96" },
      { "name": "se_handler_table", "type": "u64", "show": "hex", "when": "size >= 104" },
      { "name": "se_handler_count", "type": "u64", "when": "size >= 112" },
      { "name": "guard_cf_check_function_pointer", "type": "u64", "show": "hex", "when": "size >= 120" },
      { "name": "guard_cf_dispatch_function_pointer", "type": "u64", "show": "hex", "when": "size >= 128" },
      { "name": "guard_cf_function_table", "type": "u64", "show": "hex", "when": "size >= 136" },
      { "name": "guard_cf_function_count", "type": "u64", "when": "size >= 144" },
      { "name": "guard_flags", "type": "u32", "show": "hex", "flags": "guard_flags", "when": "size >= 148" },
      { "name": "code_integrity", "type": "raw", "size": "12", "when": "size >= 160" },
      { "name": "guard_address_taken_iat_entry_table", "type": "u64", "show": "hex", "when": "size >= 168" },
      { "name": "guard_address_taken_iat_entry_count", "type": "u64", "when": "size >= 176" },
      { "name": "guard_long_jump_target_table", "type": "u64", "show": "hex", "when": "size >= 184" },
