      { "name": "chpe_metadata_pointer", "type": "u64", "show": "hex", "when": "size >= 208" }
    ] },
    "IMAGE_DELAYLOAD_DESCRIPTOR": { "fields": [
      { "name": "attributes", "type": "u32", "show": "hex" },
      { "name": "dll_name_rva", "type": "u32", "show": "hex" },
      { "name": "module_handle_rva", "type": "u32", "show": "hex" },
      { "name": "import_address_table_rva", "type": "u32", "show": "hex" },
      { "name": "import_name_table_rva", "type": "u32", "show": "hex" },
      { "name": "bound_import_address_table_rva", "type": "u32", "show": "hex" },
      { "name": "unload_information_table_rva", "type": "u32", "show": "hex" },
      { "name": "time_date_stamp", "type": "u32", "show": "hex" },
      { "name": "dll", "type": "text", "rva": "dll_name_rva", "when": "dll_name_rva != 0" },
      { "name": "functions", "switch": "nt_headers.optional_header.magic",
        "cases": { "0x10b": "IMAGE_THUNK_DATA32", "0x20b": "IMAGE_THUNK_DATA64" },
        "terminated": true, "key": ["function.name", "ordinal"],
        "rva": "import_name_table_rva", "when": "import_name_table_rva != 0" }
    ] },
    "IMAGE_COR20_HEADER": { "fields": [
      { "name": "cb", "type": "u32", "show": "hex" },
      { "name": "major_runtime_version", "type": "u16" },
      { "name": "minor_runtime_version", "type": "u16" },
      { "name": "metadata", "type": "IMAGE_DATA_DIRECTORY" },
      { "name": "flags", "type": "u32", "show": "hex", "flags": "cor_flags" },
      { "name": "entry_point_token", "type": "u32", "show": "hex" },
      { "name": "resources", "type": "IMAGE_DATA_DIRECTORY" },
      { "name": "strong_name_signature", "type": "IMAGE_DATA_DIRECTORY" },
      { "name": "code_manager_table", "type": "IMAGE_DATA_DIRECTORY" },
      { "name": "vtable_fixups", "type": "IMAGE_DATA_DIRECTORY" },
      { "name": "export_address_table_jumps", "type": "IMAGE_DATA_DIRECTORY" },
      { "name": "managed_native_header", "type": "IMAGE_DATA_DIRECTORY" },
      { "name": "metadata_root", "type": "METADATA_ROOT", "rva": "metadata.virtual_address",
        "when": "metadata.size != 0" }
    ] },
    "METADATA_ROOT": { "fields": [
      { "name": "signature", "type": "u32", "show": "hex" },
      { "name": "major_version", "type": "u16" },
      { "name": "minor_version", "type": "u16" },
      { "name": "reserved", "type": "u32" },
      { "name": "length", "type": "u32" },
      { "name": "version", "type": "text", "size": "length" },
      { "name": "flags", "type": "u16", "show": "hex" },
      { "name": "streams", "type": "u16" },
      { "name": "stream_headers", "type": "STREAM_HEADER", "key": "name", "count": "streams" }
    ] },
    "STREAM_HEADER": { "fields": [
      { "name": "offset", "type": "u32", "show": "hex" },
      { "name": "size", "type": "u32", "show": "hex" },
      { "name": "name", "type": "text", "align": 4 },
      { "name": "bytes", "type": "raw", "at": "metadata_root.@offset + offset", "size": "size",
        "when": "size != 0" }
    ] },
    "IMAGE_IMPORT_BY_NAME": { "fields": [
      { "name": "hint", "type": "u16" },
      { "name": "name", "type": "text" }
    ] }
  },
